# DEC8 core file list, sourced by Arcade-DEC8.qsf. Paths relative to the
# project directory. Only real .qip files (QIP_FILE) may use
# $::quartus(qip_path).

# core RTL
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_snapram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_mcu.sv
