set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/d8_rotary.sv

# mc6809i (cycle-accurate 6809, jtframe copy)
set_global_assignment -name VERILOG_FILE rtl/vendor/mc6809i/mc6809i.v

# jt8051 (i8751); jt8051.uc read by $readmemb, found via SEARCH_PATH
